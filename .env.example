# Public site and Supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — webhook secret must be distinct from the API key secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dashboard accounts and signed sessions
ADMIN_DASHBOARD_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
BLOG_EDITOR_1_EMAIL=
BLOG_EDITOR_1_PASSWORD=
BLOG_EDITOR_2_EMAIL=
BLOG_EDITOR_2_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Customer and order access (use independent random values, 32+ characters)
CUSTOMER_AUTH_SECRET=
ORDER_ACCESS_SECRET=
RATE_LIMIT_SECRET=
NOTIFICATION_WORKER_SECRET=

# Email and WhatsApp notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=NutriPanda <orders@nutripanda.in>
GETGABS_API_KEY=
GETGABS_SENDER=
GETGABS_CAMPAIGN_ID=
GETGABS_TEMPLATE_LANG=en
GETGABS_TEMPLATE_ORDER_CONFIRMATION=
GETGABS_TEMPLATE_SHIPPING_UPDATE=
GETGABS_TEMPLATE_DELIVERED=

# Proship. Keep live booking disabled until sandbox verification is complete.
PROSHIP_LIVE_SHIPMENTS=false
PROSHIP_BASE_URL=
PROSHIP_USERNAME=
PROSHIP_PASSWORD=
PROSHIP_MERCHANT_ID=
PROSHIP_CHANNEL_NAME=WMS
PROSHIP_DEFAULT_HSN=21069099
PROSHIP_REQUEST_TIMEOUT_MS=15000
PROSHIP_TRACKING_URL_TEMPLATE=
PROSHIP_ITEM_WEIGHT_GRAMS=150
PROSHIP_PARCEL_LENGTH_CM=15
PROSHIP_PARCEL_BREADTH_CM=12
PROSHIP_PARCEL_HEIGHT_CM=8
PROSHIP_PICKUP_NAME=
PROSHIP_PICKUP_PHONE=
PROSHIP_PICKUP_EMAIL=
PROSHIP_PICKUP_ADDRESS=
PROSHIP_PICKUP_CITY=
PROSHIP_PICKUP_STATE=
PROSHIP_PICKUP_PINCODE=
PROSHIP_PICKUP_GSTIN=
PROSHIP_PICKUP_WAREHOUSE=

# Product analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional coupon-lead sender. It is disabled unless explicitly enabled.
COUPON_SEND_ENABLED=false
COUPON_RATE_LIMIT_SECRET=
# Cloudflare Turnstile is required for new checkout attempts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional exact production hostname check, for example nutripanda.in.
TURNSTILE_EXPECTED_HOSTNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_NUMBER=
